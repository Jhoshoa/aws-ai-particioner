{
  "name": "aws-ai-practitioner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n frontend,emulators -c blue,green \"npm run dev:frontend\" \"npm run emulators\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:functions": "npm run build:watch -w functions",
    "build": "npm run build:types && npm run build:functions && npm run build:frontend",
    "build:frontend": "npm run build -w frontend",
    "build:functions": "npm run build -w functions",
    "build:types": "npm run build -w @aws-ai-practitioner/shared-types",
    "emulators": "firebase emulators:start --import=./.firebase-data --export-on-exit",
    "emulators:ui": "firebase emulators:start --import=./.firebase-data --export-on-exit",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build:frontend && firebase deploy --only hosting",
    "deploy:functions": "npm run build:functions && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "seed": "npm run emulators & sleep 5 && node scripts/seed.js",
    "lint": "npm run lint -w frontend -w functions",
    "typecheck": "npm run typecheck -w frontend -w functions"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "firebase-tools": "^13.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
