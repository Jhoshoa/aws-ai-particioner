{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib": ["./src/lib"],
      "@lib/*": ["./src/lib/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@guards": ["./src/guards"],
      "@guards/*": ["./src/guards/*"],
      "@config": ["./src/config"],
      "@config/*": ["./src/config/*"],
      "@assets": ["./src/assets"],
      "@assets/*": ["./src/assets/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@app-types": ["./src/types"],
      "@app-types/*": ["./src/types/*"],
      "@aws-ai-practitioner/shared-types": ["../packages/shared-types/src"],
      "@aws-ai-practitioner/shared-types/*": ["../packages/shared-types/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
